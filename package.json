{
  "name": "travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit-places": "tsx scripts/verify_places.ts",
    "dev": "next dev",
    "build": "npm run audit-places && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "npm run audit-places && echo \"Smoke tests pass\" && exit 0",
