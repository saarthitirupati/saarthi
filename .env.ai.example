# ══════════════════════════════════════════════════════════════════════
# FreeLLMAPI Developer Tooling Configuration for Saarthi
# ══════════════════════════════════════════════════════════════════════
# FreeLLMAPI aggregates free tiers across 34 providers (Groq, Cerebras, 
# Google AI Studio, Mistral, OpenRouter, etc.) behind a single local endpoint.
# 
# 1. Start FreeLLMAPI (Windows .exe or Docker: http://localhost:3001)
# 2. Add your free keys at http://localhost:3001
# 3. Copy your unified API key below:

FREELLMAPI_URL=http://localhost:3001
FREELLMAPI_API_KEY=freellmapi_your_unified_key_here

# OpenAI Wire Compatibility (Used by Cursor, Aider, Cline, Continue, Codex)
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=freellmapi_your_unified_key_here

# Anthropic Wire Compatibility (Used by Claude Code)
ANTHROPIC_BASE_URL=http://localhost:3001
ANTHROPIC_API_KEY=freellmapi_your_unified_key_here

# Native Gemini Wire Compatibility (Used by Gemini CLI on /v1beta)
GEMINI_API_BASE=http://localhost:3001/v1beta
