{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/push/autonomous-cron",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/push/autonomous-cron",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/push/autonomous-cron",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/push/autonomous-cron",
      "schedule": "0 16 * * *"
    }
  ]
}
